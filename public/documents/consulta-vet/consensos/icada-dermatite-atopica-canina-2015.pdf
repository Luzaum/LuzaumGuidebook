   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">An upper limit for macromolecular crowding effects</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">BMC Biophysics 2011, 4:13. doi:10.1186/2046-1682-4-13</rdf:li>
    </rdf:Alt>
   </dc:description>
