VITE_DEEPSEEK_MODEL=deepseek-chat
VITE_DEEPSEEK_MODEL_STRATEGY=auto
VITE_DEEPSEEK_FALLBACK_MODEL=deepseek-reasoner

# Google Sign-In
VITE_GOOGLE_CLIENT_ID=

# NutriçãoVET — homologação local do motor de cálculo v3 (produção permanece OFF até rollout clínico)
